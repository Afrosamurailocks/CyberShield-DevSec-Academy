# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────── Banco de dados ───────────────────────────
# DATABASE_URL: connection string do Postgres do Supabase.
#   - SEM esta variável -> o backend usa SQLite em memória (dev local, zero setup).
#   - COM esta variável -> o backend usa o Supabase/Postgres (conexão direta `pg`).
# Onde pegar: Supabase -> Project Settings -> Database -> Connection string -> URI
#   (modo "Session"/pooler na porta 5432; troque [YOUR-PASSWORD] pela senha do DB).
# Depois rode:  npm run db:setup   (cria o schema + dados-semente no Supabase)
# NUNCA versione o .env real (está no .gitignore).
# DATABASE_URL="postgresql://postgres.abcdefgh:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# API_PORT: porta do backend (default 4000).
# API_PORT="4000"

# Chave de assinatura dos selos Security Champion (opcional; sem ela o servidor gera data/.signing-key).
# Nao use valores reais aqui; defina na sua maquina/servidor.
CHAMPION_SIGNING_KEY=

# ─────────────────────── Autenticação (ver README) ───────────────────────
# AUTH_MODE: "required" (padrão) exige login; "optional" mantém o aluno anônimo (apenas dev/testes).
# AUTH_MODE=required
# 1º administrador (só usado quando não há usuários). Sem ADMIN_BOOTSTRAP_PASSWORD, uma senha provisória
# é gerada e mostrada UMA vez no console do servidor. Troca obrigatória no 1º login. Nao versione valores reais.
# ADMIN_EMAIL=admin@suaempresa.com.br
# ADMIN_BOOTSTRAP_PASSWORD=
# Restringe o dominio dos e-mails dos usuarios (opcional).
# ALLOWED_EMAIL_DOMAIN=suaempresa.com.br
# Cookie de sessao "Secure" (obrigatorio atras de HTTPS; implicito com NODE_ENV=production).
# COOKIE_SECURE=true
# Pasta dos dados (progresso, usuarios, trilha de auditoria). Padrao: ./data. Faca backup.
# CHAMPION_DATA_DIR=
